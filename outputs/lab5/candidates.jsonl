{"id": "HS-O01:587:593", "doc_id": "HS-O01", "scenic": "黄山", "text_type": "官方路线", "source_name": "黄山旅游官方平台", "source_record_id": "fjqlyzx-Q20", "source_file": "official_huangshan.html", "source_url": "https://wap.huangshan.com.cn/detail/strategy/fjqlyzx", "sentence": "(2)二日游路线:两日游的旅客建议午后上山,与一日游旅客错峰出游。", "sentence_start": 578, "condition": "两日游的旅客", "condition_start": 587, "condition_end": 593, "advice": "建议午后上山", "advice_start": 593, "advice_end": 599, "trigger": "scene", "condition_type": "时间安排", "traveler_type": "普通游客"}
